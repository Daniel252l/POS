@model Pos.Models.DTOs.CambiarPasswordViewModel

@{
    ViewData["Title"] = Model.EsTemporal ? "Cambiar Contraseña (Obligatorio)" : "Cambiar Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-key me-2"></i>
                        @(Model.EsTemporal ? "🔴 Cambiar Contraseña (Obligatorio)" : "Cambiar Contraseña")
                    </h4>
                </div>
                <div class="card-body">
                    @if (Model.EsTemporal)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>¡Bienvenido!</strong> Esta es tu primera sesión.
                            <strong>Debes cambiar tu contraseña</strong> por razones de seguridad.
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="CambiarPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="EsTemporal" />

                        <div class="mb-3">
                            <label asp-for="PasswordActual" class="form-label fw-semibold">Contraseña Actual</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input asp-for="PasswordActual" class="form-control" type="password" />
                            </div>
                            <span asp-validation-for="PasswordActual" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevaPassword" class="form-label fw-semibold">Nueva Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                                <input asp-for="NuevaPassword" class="form-control" type="password" id="newPassword" />
                            </div>
                            <span asp-validation-for="NuevaPassword" class="text-danger"></span>
                            <div class="password-requirements mt-2">
                                <strong>Requisitos:</strong>
                                <ul class="mb-0 ps-3">
                                    <li>Mínimo 8 caracteres</li>
                                    <li>Al menos una mayúscula</li>
                                    <li>Al menos una minúscula</li>
                                    <li>Al menos un número</li>
                                    <li>Al menos un carácter especial</li>
                                    <li class="text-danger">⚠️ No debe ser similar a la contraseña anterior</li>
                                </ul>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmarPassword" class="form-label fw-semibold">Confirmar Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-check"></i></span>
                                <input asp-for="ConfirmarPassword" class="form-control" type="password" />
                            </div>
                            <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-save me-2"></i>
                            @(Model.EsTemporal ? "Cambiar y Acceder" : "Cambiar Contraseña")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .password-requirements {
        font-size: 12px;
        color: #666;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 8px;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}